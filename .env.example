# Copy to .env.local (dev) or set these in docker-compose / your environment.

# Path to your LanCache access.log
LOG_PATH=/path/to/lancache/logs/access.log

# Where the SQLite DB lives. The Steam depot mapping (~100MB) and depot caches
# are stored in this same directory, so point it at a persistent volume.
DB_PATH=./data/lancache.db

# IPs/prefixes hidden from stats by default (prefill traffic from the cache host,
# which misses heavily and skews real client numbers). Comma-separated.
# Entries ending in "." or ":" are treated as prefixes (e.g. "172." = docker bridge).
# Toggle on/off live in the UI. Setting this replaces the default list.
EXCLUDE_IPS=127.0.0.1,::1,172.,localhost

# Extra prefill clients, ADDED to EXCLUDE_IPS. Use when prefill runs from a LAN
# workstation rather than the cache host (e.g. PREFILL_IPS=192.168.1.50).
PREFILL_IPS=

# Show client hostnames via reverse DNS (PTR). Needs a LAN DNS server that
# registers DHCP hostnames. Manual names can also go in <data dir>/client-names.json.
RESOLVE_HOSTNAMES=false

# Your lancache cache retention window in days (match your CACHE_MAX_AGE).
# Used to estimate which games are "likely still cached".
CACHE_MAX_AGE_DAYS=60

# Server port
PORT=3000

# --- Event branding (optional) ---
# Shown in the header, the /display page, and the browser tab. For a logo, put
# brand-logo.svg|png|webp|jpg (max 2 MB) in the data directory next to the DB.
BRAND_NAME=
BRAND_TAGLINE=
# Hex colour for live/interactive marks, e.g. #ff7a45. Cache green and internet
# amber stay fixed; the server warns if the accent is too close to either.
BRAND_ACCENT=

# --- Access: pick ONE mode ---

# Mode 1 (recommended for LAN events): public viewing + admin login.
# Everyone can view; ingest, rebuild, update depots and saved ranges need this
# password, entered once via the "Admin" button. (ADMIN_API_KEY also works.)
ADMIN_PASSWORD=

# Mode 2: private site. When BOTH are set, nobody can view anything without
# these credentials (browser login prompt). Leave blank for public viewing.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

